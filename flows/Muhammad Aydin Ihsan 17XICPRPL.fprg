<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Muhammad Aydin Ihsan 17XICPRPL"/>
        <attribute name="authors" value="MUHAMMAD AYDIN"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-20 11:41:25 AM"/>
        <attribute name="created" value="TVVIQU1NQUQgQVlESU47TEFQVE9QLUZPTlJKSlBUOzIwMjYtMDgtMjA7MTA6MzY6MzkgQU07MzM5Mg=="/>
        <attribute name="edited" value="TVVIQU1NQUQgQVlESU47TEFQVE9QLUZPTlJKSlBUOzIwMjYtMDgtMjA7MTE6NDE6MjUgQU07MTszNDky"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="s" type="Integer" array="False" size=""/>
            <declare name="w" type="Integer" array="False" size=""/>
            <output expression="&quot;Problem 4 - Guess the Secret Number&quot;&#13;&#10;&amp;&#13;&#10;ToChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Muhammad Aydin Ihsan&quot;&#13;&#10;&amp;&#13;&#10;ToChar(13)&#13;&#10;&amp;&#13;&#10;&quot;absen: 17&quot;&#13;&#10;&amp;&#13;&#10;ToChar(13)&#13;&#10;&amp;&#13;&#10;&quot;Kelas:X ICP RPL&quot;" newline="True"/>
            <output expression="&quot;Enter your guess to start!&quot;" newline="True"/>
            <input variable="w"/>
            <assign variable="s" expression="50"/>
            <while expression="w=s==false">
                <if expression="w&lt;s==true">
                    <then>
                        <output expression="&quot;Too low, Try again!&quot;" newline="True"/>
                    </then>
                    <else>
                        <if expression="w&gt;s==true">
                            <then>
                                <output expression="&quot;Too high, Try agin!&quot;" newline="True"/>
                            </then>
                            <else>
                                <output expression="&quot;Error&quot;" newline="True"/>
                            </else>
                        </if>
                    </else>
                </if>
                <input variable="w"/>
            </while>
            <output expression="&quot;Congratulations, your guess is correct!&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
